GROQ_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Monetización (NO activar antes de los 18 del fundador). Con "true", los
# enlaces de bróker con URL de afiliado en src/lib/monetization.ts pasan a
# rel=sponsored y muestran la etiqueta "enlace de afiliado" (LSSI).
NEXT_PUBLIC_MONETIZATION_ENABLED=false

# Bing Webmaster Tools. Se genera en la propia herramienta (Settings > API access >
# API key). Sirve para leer impresiones, clics y consultas sin depender de que
# alguien exporte CSVs a mano. Bing es el canal que rinde: 54 veces las impresiones
# de Google medidas el 18-sep-2026.
BING_WEBMASTER_API_KEY=
